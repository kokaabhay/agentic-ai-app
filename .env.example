# Copy to .env and fill in your real values.
# Use your Azure OpenAI-compatible inference endpoint, not the Foundry project endpoint.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=replace_with_your_key
AZURE_CHAT_DEPLOYMENT=gpt-5.5-nano

APP_NAME=Agentic AI Application
LOG_LEVEL=INFO
AGENT_TIMEOUT_SECONDS=30
MAX_AGENT_STEPS=8
MAX_AGENT_TOOL_CALLS=10
REQUIRE_CODE_APPROVAL=true
AGENT_ALLOW_INTERNET=true
AGENT_WORKSPACE=runtime/workspaces
